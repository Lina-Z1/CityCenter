@model Order
@{
    string paymentBadgeColor = "bg-danger";
    if (Model.PaymentStatus == "pending")
    {
        paymentBadgeColor = "bg-warning text-dark";
    }
    else if (Model.PaymentStatus == "accepted")
    {
        paymentBadgeColor = "bg-success";
    }
    else if (Model.PaymentStatus == "canceled")
    {
        paymentBadgeColor = "bg-secondary";
    }


    string orderBadgeColor = "bg-danger";
    if (Model.OrderStatus == "created")
    {
        orderBadgeColor = "bg-warning text-dark";
    }
    else if (Model.OrderStatus == "accepted")
    {
        orderBadgeColor = "bg-success";
    }
    else if (Model.OrderStatus == "canceled")
    {
        orderBadgeColor = "bg-secondary";
    }
    else if (Model.OrderStatus == "shipped")
    {
        orderBadgeColor = "bg-primary";
    }
    else if (Model.OrderStatus == "delivered")
    {
        orderBadgeColor = "bg-success";
    }
    else if (Model.OrderStatus == "returned")
    {
        orderBadgeColor = "bg-info text-dark";
    }
    else if (Model.OrderStatus == "deleted")
    {
        orderBadgeColor = "bg-dark";
    }
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <a class="btn btn-link text-decoration-none text-dark ps-0" asp-controller="ClientOrders" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Orders
        </a>
        @* <h3 class="mb-0 fw-bold text-dark">Order #@Model.Id</h3> *@
    </div>
    <span class="badge rounded-pill @orderBadgeColor bg-opacity-75 fw-normal fs-6 px-3 py-2">@Model.OrderStatus</span>
</div>

<div class="row mb-4">
    <div class="col">
        <div class="card border rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="fw-semibold mb-4 d-flex align-items-center gap-2 text-dark">
                    <i class="bi bi-receipt"></i> Order
                </h5>

                <div class="row mb-3 pb-3 border-bottom">
                    <div class="col-5 text-muted small text-uppercase">Order ID</div>
                    <div class="col-7 fw-medium">#@Model.Id</div>
                </div>

                <div class="row mb-3 pb-3 border-bottom">
                    <div class="col-5 text-muted small text-uppercase">Delivery Address</div>
                    <div class="col-7 fw-medium">@Model.DeliveryAddress</div>
                </div>

                <div class="row mb-3 pb-3 border-bottom">
                    <div class="col-5 text-muted small text-uppercase">Payment Method</div>
                    <div class="col-7 fw-medium">@Model.PaymentMethod</div>
                </div>

                <div class="row mb-3 pb-3 border-bottom">
                    <div class="col-5 text-muted small text-uppercase">Payment Status</div>
                    <div class="col-7">
                        <span class="badge rounded-pill @paymentBadgeColor bg-opacity-75 fw-normal px-3 py-2">@Model.PaymentStatus</span>
                    </div>
                </div>

                <div class="row mb-3 pb-3 border-bottom">
                    <div class="col-5 text-muted small text-uppercase">Order Status</div>
                    <div class="col-7">
                        <span class="badge rounded-pill @orderBadgeColor bg-opacity-75 fw-normal px-3 py-2">@Model.OrderStatus</span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-5 text-muted small text-uppercase">Order Date</div>
                    <div class="col-7 fw-medium">@Model.CreatedAt</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border rounded-4 shadow-sm mb-4">
    <div class="card-body p-4">
        <h5 class="fw-semibold mb-3 text-dark">Items</h5>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th class="border-0" style="width: 90px"></th>
                        <th class="border-0">Description</th>
                        <th class="border-0 text-center" style="width:100px">Units</th>
                        <th class="border-0 text-end" style="width:100px">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        decimal subtotal = 0;
                        foreach (var item in Model.Items)
                        {
                            subtotal += item.UnitPrice * item.Quantity;

                            <tr>
                                <td>
                                    <img src="/products/@item.Product.ImageFileName" alt="..." class="rounded-3 border" style="height: 64px; width: 64px; object-fit:contain" />
                                </td>
                                <td>
                                    <h6 class="mb-1">
                                        <a class="link-dark text-decoration-none" asp-controller="Store"
                                           asp-action="Details" asp-route-id="@item.Product.Id">
                                            @item.Product.Name
                                        </a>
                                    </h6>
                                    <span class="text-muted small">@item.Product.Category &middot; @(item.UnitPrice)$</span>
                                </td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end fw-semibold">@(item.UnitPrice * item.Quantity)$</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end mb-4">
    <div class="card border rounded-4 shadow-sm" style="width: 280px">
        <div class="card-body p-4">
            <div class="row mb-2">
                <div class="col text-muted">Subtotal</div>
                <div class="col text-end">@(subtotal)$</div>
            </div>
            <div class="row mb-2">
                <div class="col text-muted">Shipping Fee</div>
                <div class="col text-end">@(Model.ShippingFee)$</div>
            </div>
            <hr />
            <div class="row">
                <div class="col fw-bold">Total</div>
                <div class="col text-end fw-bold fs-5">@(subtotal + Model.ShippingFee)$</div>
            </div>
        </div>
    </div>
</div>