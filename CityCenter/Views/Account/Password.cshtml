@model PasswordDto
@{
}
<div class="container col-11 col-sm-8 col-md-6 col-lg-5 mx-auto rounded-4 border shadow-sm p-4 p-md-5 bg-white">
	<h2 class="text-center mb-3 fw-bold">Edit Password</h2>
	<hr />
	@if (ViewBag.ErrorMessage != null)
	{
		<div class='alert alert-danger alert-dismissible fade show' role='alert'>
			<strong>@ViewBag.ErrorMessage</strong>
			<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
		</div>
	}
	else if (ViewBag.SuccessMessage != null)
	{
		<div class='alert alert-success alert-dismissible fade show' role='alert'>
			<strong>@ViewBag.SuccessMessage</strong>
			<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
		</div>
	}
	<form method="post">
		<div class="row mb-3">
			<label class="col-sm-4 col-form-label fw-medium">Current Password</label>
			<div class="col-sm-8">
				<input class="form-control rounded-3" type="password" asp-for="CurrentPassword">
				<span asp-validation-for="CurrentPassword" class="text-danger small"></span>
			</div>
		</div>
		<div class="row mb-3">
			<label class="col-sm-4 col-form-label fw-medium">New Password</label>
			<div class="col-sm-8">
				<input class="form-control rounded-3" type="password" asp-for="NewPassword">
				<span asp-validation-for="NewPassword" class="text-danger small"></span>
			</div>
		</div>
		<div class="row mb-3">
			<label class="col-sm-4 col-form-label fw-medium">Confirm Password</label>
			<div class="col-sm-8">
				<input class="form-control rounded-3" type="password" asp-for="ConfirmPassword">
				<span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
			</div>
		</div>
		<div class="row g-2 mt-2">
			<div class="col-12 col-sm-6 offset-sm-4 offset-md-0 col-md d-grid">
				<button type="submit" class="btn btn-dark rounded-3">Submit</button>
			</div>
			<div class="col-12 col-sm-6 col-md d-grid">
				<a class="btn btn-outline-dark rounded-3" asp-controller="Account" asp-action="Profile">Cancel</a>
			</div>
		</div>
	</form>
</div>