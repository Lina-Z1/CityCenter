@model LoginDto
@{
}
<div class="row">
    <div class="col-11 col-sm-8 col-md-6 col-lg-4 mx-auto rounded-4 border shadow-sm p-4 p-md-5 bg-white">
        <div class="text-center mb-4">           
            <h2 class="fw-bold mt-1 mb-1">Welcome Back</h2>
            <p class="text-secondary small mb-0">Log in to continue shopping</p>
        </div>
        <hr class="mb-4" />
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>@ViewBag.ErrorMessage</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <form method="post">
            <div class="mb-3">
                <label class="form-label fw-medium">Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-secondary"></i></span>
                    <input asp-for="Email" class="form-control border-start-0 rounded-end-3" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-medium">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-secondary"></i></span>
                    <input asp-for="Password" type="password" class="form-control border-start-0 rounded-end-3" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
                <label class="form-check-label small text-secondary">Remember Me</label>
            </div>
            <div class="row g-2">
                <div class="col-12 col-sm-6 d-grid">
                    <button type="submit" class="btn btn-dark rounded-3">Log in</button>
                </div>
                <div class="col-12 col-sm-6 d-grid">
                    <a class="btn btn-outline-dark rounded-3" asp-controller="Home" asp-action="Index" role="button">
                        Cancel
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>