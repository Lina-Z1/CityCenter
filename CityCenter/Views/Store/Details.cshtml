@model Product
@{
}
<div class="container py-1">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Store" asp-action="Index" class="text-decoration-none text-dark">Store</a></li>
            <li class="breadcrumb-item active text-dark" aria-current="page">@Model.Name</li>
        </ol>
    </nav>
    <div class="card border-0 shadow rounded-4 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-4 d-flex align-items-center justify-content-center bg-light p-5">
                <img src="/products/@Model.ImageFileName" class="img-fluid rounded-4" alt="@Model.Name" style="max-height: 300px; object-fit: contain;" />
            </div>
            <div class="col-md-8">
                <div class="card-body p-4 p-lg-5">

                    <span class="badge bg-success text-white fw-normal px-3 py-2 rounded-pill mb-3">
                        <i class="bi bi-check-circle-fill me-1"></i> In Stock
                    </span>


                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                        <h1 class="fw-bold mb-0 fs-2">@Model.Name</h1>
                        <span class="fs-2 fw-bold text-warning">
                            @(Model.Price)$
                        </span>
                    </div>

                    <button type="button" class="btn btn-warning btn-lg fw-semibold px-4 rounded-pill mb-4" onclick="addToCart(this, @Model.Id)">
                        Add to Cart <i class="bi bi-cart4 ms-2"></i>
                    </button>

                    <div class="d-flex flex-wrap gap-1 mb-4">
                        <span class="badge bg-light text-dark border rounded-pill d-flex align-items-center gap-1 px-2 py-1">
                            <i class="bi bi-truck icon-bounce text-primary"></i>
                            Fast Delivery
                        </span>
                        <span class="badge bg-light text-dark border rounded-pill d-flex align-items-center gap-1 px-2 py-1">
                            <i class="bi bi-shield-check icon-pulse text-success"></i>
                            1-Year Warranty
                        </span>
                        <span class="badge bg-light text-dark border rounded-pill d-flex align-items-center gap-1 px-2 py-1">
                            <i class="bi bi-arrow-repeat icon-spin text-warning"></i>
                            Easy Returns
                        </span>
                        <span class="badge bg-light text-dark border rounded-pill d-flex align-items-center gap-1 px-2 py-1">
                            <i class="bi bi-lock icon-pulse text-secondary"></i>
                            Secure Checkout
                        </span>
                    </div>

                <hr class="my-2" />

                    <div class="row mb-2">
                        <div class="col-sm-3 fw-semibold text-secondary">
                            Brand
                        </div>
                        <div class="col-sm-9">
                            @Model.Brand
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3 fw-semibold text-secondary">
                            Category
                        </div>
                        <div class="col-sm-9">
                            @Model.Category
                        </div>
                    </div>

                    <div class="fw-semibold text-secondary mb-2">Description</div> 
                      <div class="text-body" style="white-space: pre-line">@Model.Description</div>                 
                </div>             
        </div>
    </div>
    </div>
</div>


 
 
@{
    var relatedProducts = ViewBag.RelatedProducts as List<Product> ?? new List<Product>();
}
@if (relatedProducts.Any())
{
    <div class="container py-4 mt-3">
        <h3 class="fw-bold mb-3">You May Also Like</h3>
        <div class="row g-3">
            @foreach (var related in relatedProducts)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="p-3 text-center">
                            <img src="/products/@related.ImageFileName" class="img-fluid" alt="@related.Name"
                                 style="height: 180px; object-fit: contain" />
                        </div>
                        <div class="card-body text-center d-flex flex-column">
                            <span class="badge rounded-pill bg-light text-dark border px-3 py-2 mb-2
                                      align-self-center fw-normal">
                                @related.Brand · @related.Category
                            </span>
                            <h5 class="fs-6 fw-normal mb-1 text-dark">@related.Name</h5>
                            <h4 class="fs-5 fw-medium text-dark mb-2">@(related.Price)$</h4>
                            <div class="d-flex gap-2 mt-auto">
                                <a class="btn btn-outline-dark btn-sm text-dark soft-hover flex-fill" asp-controller="Store"
                                   asp-action="Details" asp-route-id="@related.Id" role="button">Details</a>
                                <button type="button" class="btn btn-dark btn-sm text-white flex-fill" onclick="addToCart(this, @related.Id)">
                                    Add to Cart <i class="bi bi-cart4"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}