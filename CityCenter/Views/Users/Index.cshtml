@model List<ApplicationUser>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
}
<h2 class="text-center mb-5 fw-bold text-dark">List of Users</h2>

<div class="card border rounded-4 shadow-sm bg-white">
    <div class="table-responsive rounded-4">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr class="text-dark small text-uppercase " style="background-color: #e9eef7 ;">
                    <th class="ps-4 py-3 fw-semibold border-0" style="letter-spacing: 0.4px;">Name</th>
                    <th class="py-3 fw-semibold border-0" style="letter-spacing: 0.4px;">Email</th>
                    <th class="py-3 fw-semibold border-0" style="letter-spacing: 0.4px;">Phone</th>
                    <th class="py-3 fw-semibold border-0" style="letter-spacing: 0.4px;">Role</th>
                    <th class="py-3 fw-semibold border-0" style="letter-spacing: 0.4px;">Created At</th>
                    <th class="text-end pe-4 py-3 fw-semibold border-0" style="letter-spacing: 0.4px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-light border text-dark d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 38px; height: 38px; font-size: 0.85rem;">
                                    @(user.FirstName?.Substring(0, 1))@(user.LastName?.Substring(0, 1))
                                </div>
                                <span class="fw-medium">@(user.FirstName + " " + user.LastName)</span>
                            </div>
                        </td>
                        <td class="text-break text-secondary">@user.Email</td>
                        <td class="text-nowrap text-secondary">@user.PhoneNumber</td>
                        <td>
                            @{
                                var roles = await UserManager.GetRolesAsync(user);
                                var rolesStr = String.Join(", ", roles);
                                string color = "bg-secondary";
                                if (roles.Contains("admin"))
                                {
                                    color = "bg-danger";
                                }
                                else if (roles.Contains("seller"))
                                {
                                    color = "bg-warning text-dark";
                                }
                                else if (roles.Contains("client"))
                                {
                                    color = "bg-info text-dark";
                                }
                                <span class="badge rounded-pill @color bg-opacity-75 fw-normal px-3 py-2">@rolesStr</span>
                            }
                        </td>
                        <td class="text-nowrap text-secondary">@user.CreatedAt.ToString("MM/dd/yyyy")</td>
                        <td class="text-end pe-4 py-3">
                            <a class="btn btn-outline-dark btn-sm rounded-3" asp-controller="Users" asp-action="Details"
                               asp-route-id="@user.Id">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<nav class="mt-4">
    <ul class="pagination justify-content-center flex-wrap">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            string active = "";
            string linkClass = "border border-dark text-dark";
            if (i == ViewBag.PageIndex)
            {
                active = "active";
                linkClass = "border border-dark bg-dark text-white";
            }
            <li class="page-item @active">
                <a class="page-link rounded-3 mx-1 @linkClass" asp-route-pageIndex="@i">@i</a>
            </li>
        }
    </ul>
</nav>